    "content": [
        {
            "_cls": "ParagraphMolecule",
            "component": "molecule.paragraph.Paragraph",
            "componentId": "6a9f4eebf749b40d332d0390",
            "properties": {
                "_cls": "_ParagraphMoleculeProperties",
                "text": "Dnešek vás upozorní na napětí, které se může nenápadně hromadit v těle. Na chvíli zpomalte, uvolněte se a změňte polohu. Krátké přerušení pracovního rytmu může přinést úlevu a zabránit tomu, aby se nepohoda dál stupňovala. Dopřejte tělu pauzu."
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "HeadlineH2Molecule",
            "component": "molecule.headline.H2",
            "componentId": "6a9f4eebf749b40d332d0391",
            "properties": {
                "_cls": "_HeadlineMoleculeProperties",
                "text": "Láska a přátelství"
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "ParagraphMolecule",
            "component": "molecule.paragraph.Paragraph",
            "componentId": "6a9f4eebf749b40d332d0392",
            "properties": {
                "_cls": "_ParagraphMoleculeProperties",
                "text": "Nepříznivý den pro vaše znamení přinese v lásce zbytečné napětí. Neřešte maličkosti a dejte citům trochu více klidu večer."
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "HeadlineH2Molecule",
            "component": "molecule.headline.H2",
            "componentId": "6a9f4eebf749b40d332d0393",
            "properties": {
                "_cls": "_HeadlineMoleculeProperties",
                "text": "Peníze a práce"
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "ParagraphMolecule",
            "component": "molecule.paragraph.Paragraph",
            "componentId": "6a9f4eebf749b40d332d0394",
            "properties": {
                "_cls": "_ParagraphMoleculeProperties",
                "text": "Práce se začne zrychlovat a úkoly budou přibývat rychleji, než by vám bylo milé. Určete pořadí a nenechte se vláčet okolím."
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "HeadlineH2Molecule",
            "component": "molecule.headline.H2",
            "componentId": "6a9f4eebf749b40d332d0395",
            "properties": {
                "_cls": "_HeadlineMoleculeProperties",
                "text": "Rodina a vztahy"
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "ParagraphMolecule",
            "component": "molecule.paragraph.Paragraph",
            "componentId": "6a9f4eebf749b40d332d0396",
            "properties": {
                "_cls": "_ParagraphMoleculeProperties",
                "text": "Jedna nepříjemná pravda dnes visí ve vzduchu. Řekněte ji blízkému citlivě, ale na rovinu, mlčení by později bolelo víc."
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "HeadlineH2Molecule",
            "component": "molecule.headline.H2",
            "componentId": "6a9f4eebf749b40d332d0397",
            "properties": {
                "_cls": "_HeadlineMoleculeProperties",
                "text": "Zdraví a kondice"
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "ParagraphMolecule",
            "component": "molecule.paragraph.Paragraph",
            "componentId": "6a9f4eebf749b40d332d0398",
            "properties": {
                "_cls": "_ParagraphMoleculeProperties",
                "text": "Ramena nesou víc napětí, než si uvědomujete. Spusťte je dolů, zakružte pažemi a dopřejte krku chvíli bez pracovního shonu."
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "HeadlineH2Molecule",
            "component": "molecule.headline.H2",
            "componentId": "6a9f4eebf749b40d332d0399",
            "properties": {
                "_cls": "_HeadlineMoleculeProperties",
                "text": "Aktivity vhodné pro dnešní den"
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
            }
        },
        {
            "_cls": "ParagraphMolecule",
            "component": "molecule.paragraph.Paragraph",
            "componentId": "6a9f4eebf749b40d332d039a",
            "properties": {
                "_cls": "_ParagraphMoleculeProperties",
                "text": "Klidná večeře s partnerem, třídění pracovních úkolů, upřímný rozhovor, jemná jóga, pletení šály večer, procházka parkem."
            },
            "settings": {
                "_cls": "BaseMoleculeSettings"
